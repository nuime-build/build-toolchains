ishikopath = envvar("ISHIKO_CPP_ROOT");
import $(ishikopath)/process/include/Ishiko/Process.bkl;

setting NUIME_BUILDTOOLCHAINS_ROOT
{
    help = "Path to the Nuime/BuildToolchains installation";
    default = '$(NUIME_ROOT)/build-toolchains';
}

template NuimeBuildToolchains : IshikoProcess
{
    includedirs += $(NUIME_BUILDTOOLCHAINS_ROOT)/include;

    if ($(toolset) == gnu)
    {
        libdirs += $(NUIME_BUILDTOOLCHAINS_ROOT)/lib;
    }

    if ($(toolset) != gnu)
    {
        libdirs += $(NUIME_BUILDTOOLCHAINS_ROOT)/lib/$(arch);
    }
}
