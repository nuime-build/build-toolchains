nuimepath = envvar("NUIME_ROOT");
import $(nuimepath)/build-toolchains/include/Nuime/NuimeBuildToolchains.bkl;
ishikopath = envvar("ISHIKO_CPP_ROOT");
import $(ishikopath)/test-framework/include/Ishiko/TestFramework.bkl;

toolsets = gnu vs2022 vs2019 vs2017;

gnu.makefile = ../gnumake/GNUmakefile;
vs2022.solutionfile = ../vc17/nuime_buildtoolchains_tests.sln;
vs2019.solutionfile = ../vc16/nuime_buildtoolchains_tests.sln;
vs2017.solutionfile = ../vc15/nuime_buildtoolchains_tests.sln;

program nuime_buildtoolchains_tests : NuimeBuildToolchains, IshikoTestFramework
{
    archs = x86 x86_64;

    if ($(toolset) == gnu)
    {
        cxx-compiler-options = "-std=c++11";
        libs += nuime_buildtoolchains IshikoTestFramework IshikoTestFrameworkCore IshikoConfiguration IshikoXML IshikoFileSystem IshikoIO IshikoProcess IshikoTime IshikoText IshikoErrors IshikoBasePlatform;
        libs += fmt boost_filesystem;
    }

    if ($(toolset) != gnu)
    {
        cxx-compiler-options = "/utf-8";
    }

    headers
    {
        ../../src/CMakeToolchainTests.h
        ../../src/MakeToolchainTests.h
        ../../src/MSBuildToolchainTests.h
    }

    sources
    {
        ../../src/CMakeToolchainTests.cpp
        ../../src/main.cpp
        ../../src/MakeToolchainTests.cpp
        ../../src/MSBuildToolchainTests.cpp
    }
}
